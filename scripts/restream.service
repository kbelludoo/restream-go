[Unit]
Description=Restream Go — RTMP fan-out
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/restream
ExecStart=/home/ubuntu/restream/restream-linux
Restart=always
RestartSec=5s
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
Environment=GOGC=50

[Install]
WantedBy=multi-user.target
